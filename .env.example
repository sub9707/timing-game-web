# 배포 주소 (끝에 / 포함 권장) — canonical·hreflang·OG 절대 주소·sitemap.xml 에 씀
VITE_SITE_URL=https://example.com/
# 검색 엔진 소유 확인 코드 (Search Console · 네이버 서치어드바이저 · Bing 웹마스터) — 없으면 비워 두기
VITE_GOOGLE_SITE_VERIFICATION=
VITE_NAVER_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=

# 구글 애드센스 — 복사해서 .env (또는 .env.production) 로 저장 후 값 입력
# 비워두면 광고 영역이 생기지 않아요 (개발 서버에서는 자리만 표시)
VITE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# 160x600 세로 배너 광고 단위 ID
VITE_ADSENSE_SLOT_LEFT=
VITE_ADSENSE_SLOT_RIGHT=

# Google Analytics 4 측정 ID — 비워두면 통계를 보내지 않아요 (개발 서버·송출 창은 항상 제외)
VITE_GA_ID=
